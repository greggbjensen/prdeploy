{
  "name": "prdeploy",
  "description": "Manages feature branch deployments across environments through a pull request.",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "start": "npm-run-all build run",
    "start:watch": "npm-run-all --parallel build:watch run:watch",
    "webhooks": "npx smee -u https://smee.io/3IVRinBfSv0D9bz -t http://localhost:3000/webhooks",
    "start:prod": "npm run build && node dist/src/app.js",
    "build": "tsc && tsc-alias",
    "build:watch": "concurrently --kill-others \"tsc -w\" \"tsc-alias -w\"",
    "run": "nodemon dist/src/app.js",
    "run:watch": "nodemon dist/src/app.js --watch dist",
    "format": "prettier --write src/**/*.ts",
    "format-check": "prettier --check src/**/*.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "test": "cross-env USE_MOCKS=true vitest run",
    "test:watch": "cross-env USE_MOCKS=true vitest",
    "test:ui": "cross-env USE_MOCKS=true vitest --ui",
    "checks": "npm-run-all lint build test"
  },
  "devDependencies": {
    "@octokit/types": "^16.0.0",
    "@octokit/webhooks-types": "^7.6.1",
    "@types/adm-zip": "^0.5.7",
    "@types/async-lock": "^1.4.2",
    "@types/lodash": "^4.17.21",
    "@types/memory-cache": "^0.2.6",
    "@typescript-eslint/parser": "^8.48.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-github": "^6.0.0",
    "nodemon": "^3.1.11",
    "npm-run-all": "^4.1.5",
    "smee-client": "^5.0.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8",
    "@rollup/plugin-typescript": "^12.1.1"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.940.0",
    "@octokit/rest": "^22.0.1",
    "adm-zip": "^0.5.16",
    "async-lock": "^1.4.1",
    "dotenv": "^17.2.3",
    "handlebars": "^4.7.8",
    "jira.js": "^5.2.2",
    "lodash": "^4.17.21",
    "memory-cache": "^0.2.0",
    "octokit": "^5.0.5",
    "reflect-metadata": "^0.2.2",
    "slack": "^11.0.2",
    "slackify-markdown": "^5.0.0",
    "tsyringe": "^4.10.0",
    "yaml": "^2.8.1"
  }
}
