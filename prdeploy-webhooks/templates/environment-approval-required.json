{
  "blocks": [
    {
      "type": "context",
      "elements": [
        {
          "type": "image",
          "image_url": "https://placehold.co/32x32/{{color environment.color}}/ffffff/png?text={{environment.name}}",
          "alt_text": "{{environment.name}}"
        },
        {
          "type": "mrkdwn",
          "text": "{{#if isRollback}}*ROLLBACK* {{/if}}<https://github.com/{{owner}}/{{repo}}/actions/runs/{{run.id}}/attempts/{{run.run_attempt}}|Deployment> to *<{{environment.url}}|{{environment.name}}>* requires *<https://github.com/{{owner}}/{{repo}}/actions/runs/{{run.id}}/attempts/{{run.run_attempt}}|approval>* for *{{slackUser.name}}*."
        }
      ]
    }
  ]
}
