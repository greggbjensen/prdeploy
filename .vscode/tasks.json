{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build API",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/prdeploy-api/src/PrDeploy.Api/PrDeploy.Api.csproj",
        "--configuration",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "Build App",
      "type": "process",
      "command": "npm",
      "args": ["run", "build"],
      "options": {
        "cwd": "${workspaceFolder}/prdeploy-app"
      },
      "problemMatcher": "$tsc",
      "group": "build"
    },
    {
      "label": "Serve App",
      "type": "process",
      "command": "npm",
      "args": ["start"],
      "options": {
        "cwd": "${workspaceFolder}/prdeploy-app"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "angular",
        "pattern": {
          "regexp": "^\\s*✘ \\[ERROR\\]\\s+(.*)$",
          "message": 1,
          "severity": "error"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*http://localhost:4301/.*"
        }
      }
    },
    {
      "label": "Stop API Build Servers",
      "detail": "Shuts down the MSBuild and compiler server processes left running by Build API.",
      "type": "process",
      "command": "dotnet",
      "args": ["build-server", "shutdown"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "Stop App",
      "detail": "Terminates the background Serve App task when the App debug session ends.",
      "type": "shell",
      "command": "echo ${input:terminateServeApp}",
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "terminateServeApp",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "Serve App"
    }
  ]
}
