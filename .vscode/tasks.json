{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build API",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/prdeploy-api/src/PrDeploy.Api/PrDeploy.Api.csproj",
        "--configuration",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "Build App",
      "type": "process",
      "command": "npm",
      "args": ["run", "build"],
      "options": {
        "cwd": "${workspaceFolder}/prdeploy-app"
      },
      "problemMatcher": "$tsc",
      "group": "build"
    },
    {
      "label": "Serve App",
      "type": "process",
      "command": "npm",
      "args": ["start"],
      "options": {
        "cwd": "${workspaceFolder}/prdeploy-app"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "angular",
        "pattern": {
          "regexp": "^\\s*✘ \\[ERROR\\]\\s+(.*)$",
          "message": 1,
          "severity": "error"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*http://localhost:4301/.*"
        }
      }
    },
    {
      "label": "Stop API Build Servers",
      "detail": "Shuts down the MSBuild and compiler server processes left running by Build API.",
      "type": "process",
      "command": "dotnet",
      "args": ["build-server", "shutdown"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "Kill API Process",
      "detail": "Kills any process still listening on the API port (4302).",
      "type": "shell",
      "command": "lsof -ti tcp:4302 | xargs kill 2>/dev/null || true",
      "windows": {
        "command": "powershell -NoProfile -Command \"Get-NetTCPConnection -LocalPort 4302 -State Listen -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }\""
      },
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "Stop API",
      "detail": "Stops the API process and shuts down the build servers when the API debug session ends.",
      "dependsOn": ["Kill API Process", "Stop API Build Servers"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Stop Smee",
      "detail": "Kills the smee-client webhook forwarder when the Smee debug session ends.",
      "type": "shell",
      "command": "pkill -f smee-client || true",
      "windows": {
        "command": "powershell -NoProfile -Command \"Get-CimInstance Win32_Process -Filter \\\"CommandLine like '%smee-client%'\\\" | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }\""
      },
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "Kill App Server",
      "detail": "Kills any process still listening on the App dev server port (4301).",
      "type": "shell",
      "command": "lsof -ti tcp:4301 | xargs kill 2>/dev/null || true",
      "windows": {
        "command": "powershell -NoProfile -Command \"Get-NetTCPConnection -LocalPort 4301 -State Listen -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }\""
      },
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "Stop App",
      "detail": "Stops the Serve App task and any dev server left on its port when the App debug session ends.",
      "dependsOn": ["Terminate Serve App", "Kill App Server"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Terminate Serve App",
      "detail": "Terminates the background Serve App task.",
      "type": "process",
      "command": "echo",
      "args": ["${input:terminateServeApp}"],
      "windows": {
        "command": "cmd",
        "args": ["/c", "echo", "${input:terminateServeApp}"]
      },
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "terminateServeApp",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "Serve App"
    }
  ]
}
