{
  "Storage": {
    "DeploymentValuePathPrefix": "/prdeploy",
    "AWS": {
      "Region": "us-west-2",
      "Profile": "prdeploy"
    }
  },
  "ApolloSandbox": {
    "Enabled": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Debug"
      }
    ]
  }
}
