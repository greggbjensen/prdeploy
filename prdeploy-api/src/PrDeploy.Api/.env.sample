# Make a copy of this file as .env and fill in the values for local development.
# The .env file will not be checked in.

# Get these from GitHub OAuth App.
GitHubAuth__ClientId=""
GitHubAuth__ClientSecret=""

# GitHub organizations whose members may sign in, one numbered entry per organization.
GitHubAuth__AllowedOrganizations__0=""

# Any string that is at least 16 characters long.
Jwt__Key=""
Jwt__TokenEncryptionKey=""

# Get these from GitHub App, used for webhooks.
GitHubApp__AppId=""
GitHubApp__PrivateKeyPath="../../gh-app-key-local.pem"
GitHubApp__WebhookSecret=""